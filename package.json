{
  "name": "angular-signals-learning",
  "displayName": "Angular Signals Learning",
  "description": "Learn Angular Signals through step-by-step interactive lessons.",
  "version": "0.0.1",
  "publisher": "Ajjayyaswamy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ajjayyaswamy/angular-signals-learning.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./out/extension.js",
  "contributes": {
